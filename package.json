{
  "name": "veyra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @veyra/server dev",
    "dev:web": "pnpm --filter @veyra/web dev",
    "dev:desktop": "pnpm --filter @veyra/desktop dev",
    "install:mac": "bash scripts/install-mac.sh",
    "package:mac": "pnpm --filter @veyra/desktop package:mac"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  }
}
